# Google OAuth (Gmail send + inbox). Create an OAuth client of type
# "Web application" in Google Cloud Console and register this exact
# redirect URI:  http://127.0.0.1:8000/api/mailbox/oauth/gmail/callback
# While the consent screen is in "Testing", add every Gmail account you
# log in with (sender AND receiver) under "Test users".
SECUREMAILSCOPE_GOOGLE_CLIENT_ID=
SECUREMAILSCOPE_GOOGLE_CLIENT_SECRET=

# Optional: Microsoft OAuth (sending only)
# SECUREMAILSCOPE_MICROSOFT_CLIENT_ID=
# SECUREMAILSCOPE_MICROSOFT_CLIENT_SECRET=

# Optional: LLM for the AI explanation layer. Without it the
# deterministic fallback engine is used (fully offline).
# SECUREMAILSCOPE_AI_API_KEY=
# SECUREMAILSCOPE_AI_BASE_URL=https://api.openai.com/v1
# SECUREMAILSCOPE_AI_MODEL=
