# ---- Secrets: NEVER commit ------------------------------------------
# OAuth client secret / API keys (copy backend/.env.example instead)
.env
*.env
!.env.example

# Local databases: saved mailboxes, OAuth access/refresh tokens,
# registered E2E public keys. Created automatically on first run.
backend/data/

# Exported E2E identity backups contain PRIVATE keys
securemailscope-identity-*.json

